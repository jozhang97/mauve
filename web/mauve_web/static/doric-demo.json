  "hpylori_policy": {
    "publication": "https://doi.org/10.1093/nar/gks742",
    "selection": "One upstream oriC1 region adjacent to dnaA, exact accession, length, whole-chromosome checksum and region sequence verified. Other matching DoriC regions retained as provenance; no arbitrary selection among unrelated origins."
  },
  "bsubtilis_policy": {
    "publication": "https://pubmed.ncbi.nlm.nih.gov/8918236/",
    "selection": "One sequence-verified downstream oriC2 adjacent to dnaA. Exact accession, chromosome length and checksum required. Circular regions supported. A one-base start correction is accepted only when the entire DoriC region sequence matches and the end is unchanged; reported starts retained."
  }
